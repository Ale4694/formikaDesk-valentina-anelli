{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoParts Gestionale",

  "version": "1.0.45",
  "identifier": "it.autoparts.gestionale",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "AutoParts Gestionale",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "config.json": "config.json"
    },
    "category": "Business",
    "shortDescription": "Gestionale ricambi auto",
    "longDescription": "Gestionale desktop per officine e rivenditori di ricambi auto. Magazzino, fatturazione, clienti e fornitori."
  }
}
